# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage / type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Jupyter
.ipynb_checkpoints/

# ---- Secrets / credentials (IMPORTANT) ----
# LLM API keys, GitHub scraper tokens, etc. NEVER commit these.
.env
.env.*
*.key
secrets.*
config.local.*

# ---- Project data hygiene ----
# Do NOT commit access-gated / non-redistributable third-party datasets
# (e.g. Ur et al. 2016 IFTTT recipes). Keep raw scraped dumps out of git;
# commit only the cleaned, licensed, hand-labeled corpus under corpus/.
corpus/raw/
data/raw/
data/gated/
*.gated

# Large intermediate artifacts
*.sqlite
*.db
scratch/
tmp/

# Home Assistant local test instance (Docker) config & state
ha-config/
homeassistant/.storage/

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
